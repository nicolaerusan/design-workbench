{
  "name": "@design-workbench/react",
  "version": "0.2.0",
  "description": "React component design workbench for AI-assisted iteration, side-by-side variants, and Pattern Garden references",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src",
    "README.md",
    "cli"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaerusan/design-workbench.git"
  },
  "homepage": "https://github.com/nicolaerusan/design-workbench#readme",
  "bugs": {
    "url": "https://github.com/nicolaerusan/design-workbench/issues"
  },
  "keywords": [
    "react",
    "design-workbench",
    "component-library",
    "design-system",
    "pattern-garden"
  ],
  "bin": {
    "design-workbench": "./cli/index.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
