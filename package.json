{
  "name": "designbench",
  "version": "0.3.0",
  "description": "React component design workbench for AI-assisted iteration, side-by-side variants, and Pattern Garden references",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "cli",
    "SECURITY.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaerusan/design-workbench.git"
  },
  "homepage": "https://github.com/nicolaerusan/design-workbench#readme",
  "bugs": {
    "url": "https://github.com/nicolaerusan/design-workbench/issues"
  },
  "keywords": [
    "react",
    "design-workbench",
    "component-library",
    "design-system",
    "pattern-garden"
  ],
  "bin": {
    "designbench": "./cli/index.mjs",
    "design-workbench": "./cli/index.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react-resizable-panels": "^3.0.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Nicolae Rusan"
}
